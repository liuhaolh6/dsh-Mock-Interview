{
  "name": "dsh-mock-interview",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Mock interview coach for DeepSeek Harness: feed it a resume and a target role, sit a realistic technical interview (fundamentals, project deep-dives, live coding), then read a scored report with concrete fixes.",
  "icon": "icon.svg",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "icon.svg",
    "README.md"
  ],
  "scripts": {
    "build": "node --check index.js && node --check client.js && node --check lib/contracts.js",
    "lint": "node scripts/contract-lint.mjs",
    "test": "node --test \"tests/unit/**/*.test.mjs\" \"tests/integration/**/*.test.mjs\"",
    "e2e": "node --test \"tests/e2e/**/*.test.mjs\"",
    "coverage": "node --test --experimental-test-coverage --test-coverage-include=\"lib/**\" --test-coverage-include=\"index.js\" --test-coverage-lines=85 \"tests/unit/**/*.test.mjs\" \"tests/integration/**/*.test.mjs\""
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.2": "compatible"
      }
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "interview",
    "mock-interview"
  ],
  "license": "MIT"
}
